{
  "ai-config-ccg-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {"type": "command", "command": "python3 -I ~/ai-config-ccg/hooks/guard-bash.py", "timeout": 10}
        ]
      }
    ]
  },
  "ai-config-ccg-reminder": {
    "PreInvocation": [
      {"type": "command", "command": "bash ~/ai-config-ccg/hooks/prompt-reminder.sh --antigravity", "timeout": 5}
    ]
  },
  "ai-config-ccg-proof-gate": {
    "Stop": [
      {"type": "command", "command": "python3 -I ~/ai-config-ccg/hooks/proof-gate.py", "timeout": 15}
    ]
  }
}
