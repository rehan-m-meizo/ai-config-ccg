# Codex command rules: "forbidden" refuses, "prompt" asks the user first.
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Push needs your approval now.")
prefix_rule(pattern = ["git", "tag"], decision = "prompt", justification = "Tagging needs your approval now.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "prompt", justification = "Discards uncommitted work.")
prefix_rule(pattern = ["git", "checkout", ["--", "."]], decision = "prompt", justification = "Discards uncommitted work.")
prefix_rule(pattern = ["git", "restore"], decision = "prompt", justification = "Discards uncommitted work.")
prefix_rule(pattern = ["git", "clean"], decision = "prompt", justification = "Deletes untracked files.")
prefix_rule(pattern = ["git", "stash"], decision = "prompt", justification = "Stash hides others' work.")
prefix_rule(pattern = ["git", "branch", "-D"], decision = "prompt", justification = "Force-deletes a branch.")
prefix_rule(pattern = ["git", "commit", "--no-verify"], decision = "forbidden", justification = "Do not skip git hooks.")
prefix_rule(pattern = ["rm", ["-rf", "-fr", "-Rf", "-r", "-R"]], decision = "prompt", justification = "Recursive delete.")
prefix_rule(pattern = ["kubectl", ["apply", "delete", "rollout", "scale", "patch", "edit", "replace", "create"]], decision = "prompt", justification = "Cluster change needs approval.")
prefix_rule(pattern = ["helm", ["install", "upgrade", "uninstall", "rollback"]], decision = "prompt", justification = "Cluster change needs approval.")
prefix_rule(pattern = ["docker", "push"], decision = "prompt", justification = "Publishing an image needs approval.")
prefix_rule(pattern = ["gh", "pr", ["create", "merge"]], decision = "prompt", justification = "Publishing needs approval.")
prefix_rule(pattern = ["gh", "release", "create"], decision = "prompt", justification = "Publishing needs approval.")
